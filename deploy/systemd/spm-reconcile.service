# SPM claims-ledger reconciliation pass (proxy/src/claims/reconcile-main.ts).
# Runs the same command as `pnpm -C proxy reconcile` (see proxy/package.json),
# but calls node directly so the unit does not depend on pnpm being on PATH.
#
# Install: copy this file and spm-reconcile.timer to
# /etc/systemd/system/, edit the two paths marked EDIT below, then follow
# docs/RUNBOOK-mainnet-launch.md section 6.
#
# The reconcile runner only reads the chain through the indexer
# (proxy/src/claims/indexer.ts) and the local audit.db. It never signs or
# submits a transaction, so it never needs SPM_DONOR_MNEMONIC or any other
# mnemonic. Do not add one to this unit.

[Unit]
Description=SPM claims-ledger reconciliation pass
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=spm
Group=spm

# EDIT: set to the real install path. proxy/.env.example expects the
# repository root's .env one level up (see ExecStart below).
WorkingDirectory=/opt/spm/proxy

# EDIT: confirm this path with `sudo -u spm which node`. systemd does not
# read the interactive shell PATH, so a node installed under a user's home
# directory (nvm, etc.) will not resolve here, and ProtectHome=true below
# blocks /home outright. Install node system-wide (e.g. /usr/bin/node or
# /usr/local/bin/node) for the spm user to run this unit.
#
# Flags mirror proxy/package.json's "reconcile" script exactly.
ExecStart=/usr/bin/node --env-file=../.env --import tsx/esm src/claims/reconcile-main.ts

# Hardening. Do not add capabilities or widen these without a reason.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

# EDIT: proxy/src/db.ts resolves the database at $SQLITE_PATH, or
# ./audit.db under WorkingDirectory when unset (proxy/.env.example sets
# SQLITE_PATH=./audit.db). ProtectSystem=strict makes everything else
# read-only, so the database's directory must be listed here. If the
# server's .env points SQLITE_PATH elsewhere, change this to match — do not
# widen it past the one directory that holds audit.db.
ReadWritePaths=/opt/spm/proxy

# No [Install] section: the timer unit activates this service. Enable
# spm-reconcile.timer, not this service, and use `systemctl start
# spm-reconcile.service` only for a manual one-off run.
