# SPM nightly job (proxy/src/claims/nightly-main.ts, SPEC.md §13.2): one
# pass, in order, of reconcile -> back up -> credit. Runs inside the proxy
# Docker image, via `docker compose run --rm proxy pnpm nightly` (mirrors
# compose.yaml's own `docker compose run --rm proxy ...` record-review
# flow) — never by executing node on the bare host, since the credit step
# needs the proxy image's own dependency tree (algosdk) and the crediter
# key.
#
# Install: copy this file and spm-nightly.timer to /etc/systemd/system/,
# edit the two paths marked EDIT below, then follow
# docs/RUNBOOK-mainnet-launch.md section 6 (update its docker-based steps
# to match this unit; that section still describes the old direct-node
# reconcile runner).
#
# This unit runs `node` directly against the built image, not `pnpm
# nightly`: the "nightly" package.json script passes `--env-file=../.env`,
# a convenience for local, non-Docker development (`pnpm -C proxy
# nightly`), and /app/.env does not exist in the image — the container
# gets its environment from compose.yaml's env_file, not a mounted .env
# file. ExecStart below bypasses that script instead of relying on it.

[Unit]
Description=SPM nightly job (reconcile, back up, credit)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=spm
Group=spm

# EDIT: set to the deployed repository root — the directory that holds
# compose.yaml (for example /opt/spm). Not proxy/: `docker compose run`
# reads compose.yaml from the working directory.
WorkingDirectory=/opt/spm

# EDIT: confirm this path with `sudo -u spm which docker`. systemd does
# not read the interactive shell PATH.
#
# Runs node directly, inside the proxy image's own WORKDIR (/app/proxy,
# see proxy/Dockerfile) — not `pnpm nightly` (see the banner comment above).
# tsx is a devDependency but stays in the runtime image (proxy/Dockerfile's
# own comment on its "start" CMD), so --import tsx/esm works here too.
ExecStart=/usr/bin/docker compose run --rm proxy node --import tsx/esm src/claims/nightly-main.ts

# Hardening. Do not add capabilities or widen these without a reason. This
# unit only invokes the `docker` CLI against the Docker daemon socket; it
# never reads or writes audit.db or BACKUP_DIR itself — the proxy
# container does, inside its own mounts (compose.yaml).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

# No [Install] section: the timer unit activates this service. Enable
# spm-nightly.timer, not this service, and use `systemctl start
# spm-nightly.service` only for a manual one-off run.
