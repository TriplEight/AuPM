#!/usr/bin/env bash
# .githooks/pre-commit
#
# Wired with: git config core.hooksPath .githooks
# No dependency needed: a plain hooks path replaces husky/lint-staged, both
# of which add postinstall scripts. Postinstall scripts are blocked here.
#
# Runs, in order: the invariant guard, Biome on the staged files, then the
# workspace typecheck. Fails the commit when any step fails.

set -u

repo_root="$(git rev-parse --show-toplevel)" || exit 1
cd "$repo_root" || exit 1

echo "pre-commit: running scripts/guard.sh"
bash scripts/guard.sh
guard_status=$?
if [ "$guard_status" -ne 0 ]; then
  echo "pre-commit: guard.sh failed. Fix the invariant violation above."
  exit 1
fi

staged_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.js' '*.jsx' '*.json' '*.mjs' '*.cjs')

if [ -n "$staged_files" ]; then
  echo "pre-commit: running biome check on staged files"
  # shellcheck disable=SC2086
  pnpm exec biome check $staged_files
  biome_status=$?
  if [ "$biome_status" -ne 0 ]; then
    echo "pre-commit: biome check failed. Fix the findings above."
    exit 1
  fi
fi

echo "pre-commit: running pnpm typecheck"
pnpm typecheck
typecheck_status=$?
if [ "$typecheck_status" -ne 0 ]; then
  echo "pre-commit: typecheck failed. Fix the errors above."
  exit 1
fi

echo "pre-commit: all checks passed"
exit 0
