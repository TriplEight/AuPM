{
  "name": "spm",
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "contracts",
    "proxy",
    "mcp",
    "cli"
  ],
  "scripts": {
    "test": "pnpm --filter './proxy' test && pnpm --filter './contracts' test",
    "typecheck": "pnpm run --filter './contracts' check-types && pnpm -C proxy exec tsc --noEmit && pnpm -C mcp exec tsc --noEmit && pnpm -C cli exec tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "guard": "bash scripts/guard.sh"
  },
  "repository": {
    "type": "git",
    "url": "ssh://git@ssh.github.com:443/tripleight/spm.git"
  },
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.5.14"
  }
}
