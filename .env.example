# SPM — environment variables template
# Copy to .env and fill in real values

# ---------------------------------------------------------------------------
# MainNet x402 config (proxy/src/config.ts). MainNet is the target; TestNet
# below is pre-flight rehearsal only. NETWORK selects which CAIP-2 network id
# and USDC ASA id the proxy uses; it defaults to mainnet.
# ---------------------------------------------------------------------------
# NETWORK=mainnet | testnet (default: mainnet)
NETWORK=mainnet

# CAIP-2 id and USDC ASA id are selected in code from @x402-avm/avm by
# NETWORK — not read from the environment. Reference values:
#   ALGORAND_MAINNET_CAIP2 = algorand:wGHE2Pwdvd7S12BL5FaOP20EGYesN73ktiC1qzkkit8=
#   USDC_MAINNET_ASA_ID    = 31566704
#   ALGORAND_TESTNET_CAIP2 = algorand:testnet (see @x402-avm/avm)
#   USDC_TESTNET_ASA_ID    = 10458941

# GoPlausible facilitator (mandatory — no local facilitator, no direct
# chain submission). The resolved `feePayer` is read from the facilitator's
# getSupported() at boot, logged, and used as `extra.feePayer` on every paid
# route — it is never hardcoded here. The attribution tag
# ("x402-global-challenge") is set in code, not the environment.
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Algorand node (MainNet)
ALGOD_SERVER=https://mainnet-api.algonode.cloud
ALGOD_TOKEN=
ALGOD_PORT=443

# Algorand indexer (MainNet) — pnpm -C proxy reconcile only. Lists confirmed
# USDC axfers into SPLIT_APP_ADDRESS for nightly claims-ledger
# reconciliation (SPEC-v3.md 5.2). Not read by the running proxy.
INDEXER_URL=https://mainnet-idx.algonode.cloud

# SplitRouter app — payTo for every paid route. Fixed for the whole
# competition; it is the leaderboard key. Never change it once payments land.
SPLIT_APP_ID=
SPLIT_APP_ADDRESS=

# Attestation signing key (DSSE / ed25519). Unfunded, never used on-chain,
# separate from payTo/admin/pool keys. Hot on the server by necessity. Either
# a 25-word Algorand mnemonic or a hex-encoded 32-byte seed.
ATTEST_SIGNING_KEY=

# Attestation issuer — the real HTTPS domain, used as `predicate.issuer` and
# as the base of the predicate-type URLs on every signed statement. Defaults
# to a placeholder in proxy/src/config.ts if unset.
SPM_ISSUER_URL=

# Payer wallet (MCP server — fund with ALGO + USDC on TestNet for rehearsal)
SPM_DONOR_MNEMONIC=

# Proxy config
PORT=4873
SQLITE_PATH=./audit.db
SPM_PROXY_URL=http://localhost:4873

# TRUST_PROXY=1 | true (default: unset/false — do not trust X-Forwarded-For)
# Enable only when this proxy sits behind exactly one known reverse proxy
# (e.g. a load balancer or CDN edge) that itself appends the real client
# address as the last, rightmost entry of X-Forwarded-For before forwarding
# the request here. When enabled, the free-attest rate limiter reads that
# last entry. WARNING: enabling this with no such proxy in front — or with
# more than one hop — lets a caller spoof the header and bypass the
# free-path rate limit, the control against using SPM as an unpriced
# signing oracle.
TRUST_PROXY=

# ---------------------------------------------------------------------------
# BOOTSTRAP ONLY — never present on the running server.
#
# WARNING: the values below belong in a local .env on a workstation, used once
# to deploy and to opt the recipients into USDC. Delete them before the server
# .env is created, and never deploy a server with them set.
#
# These mnemonics are unavoidable at bootstrap for one reason: an Algorand ASA
# opt-in must be signed by the account being opted in. setRecipients() only
# stores addresses, and distribute() is permissionless, so the running server
# never needs any recipient key. Payouts are signed locally, and
# scripts/payout.ts takes a key-file argument rather than reading the
# environment.
#
# Consumers: contracts/smart_contracts/split_router/deploy-config.ts and
# scripts/finish-setup.mjs.
# ---------------------------------------------------------------------------
PAYER_ADDR=
AUDITOR_ADDR=
AUDITOR_MNEMONIC=
MAINTAINER_ADDR=
MAINTAINER_MNEMONIC=
ADVERSARIAL_ADDR=
ADVERSARIAL_MNEMONIC=
TREASURY_ADDR=
TREASURY_MNEMONIC=
OPS_ADDR=
OPS_MNEMONIC=
