# SPM — environment variables template
# Copy to .env and fill in real values

# ---------------------------------------------------------------------------
# MainNet x402 config (proxy/src/config.ts). MainNet is the target; TestNet
# below is pre-flight rehearsal only. NETWORK selects which CAIP-2 network id
# and USDC ASA id the proxy uses; it defaults to mainnet.
# ---------------------------------------------------------------------------
# NETWORK=mainnet | testnet (default: mainnet)
NETWORK=mainnet

# Guards contracts/smart_contracts/payment_router/deploy-config.ts's deploy()
# on MainNet (R2). deploy() takes no CLI flag (index.ts calls it with none),
# so this is an env-var equivalent of scripts/*.mjs's --confirm-mainnet.
# Unset or anything other than "1" refuses a MainNet deploy. No effect on
# TestNet. Never set this permanently; set it only for the one deploy run.
CONFIRM_MAINNET=

# CAIP-2 id and USDC ASA id are selected in code from @x402-avm/avm by
# NETWORK — not read from the environment. Reference values:
#   ALGORAND_MAINNET_CAIP2 = algorand:wGHE2Pwdvd7S12BL5FaOP20EGYesN73ktiC1qzkkit8=
#   USDC_MAINNET_ASA_ID    = 31566704
#   ALGORAND_TESTNET_CAIP2 = algorand:testnet (see @x402-avm/avm)
#   USDC_TESTNET_ASA_ID    = 10458941

# GoPlausible facilitator (mandatory — no local facilitator, no direct
# chain submission). The resolved `feePayer` is read from the facilitator's
# getSupported() at boot, logged, and used as `extra.feePayer` on every paid
# route — it is never hardcoded here. The attribution tag
# ("x402-global-challenge") is set in code, not the environment.
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Algorand node (MainNet)
ALGOD_SERVER=https://mainnet-api.algonode.cloud
ALGOD_TOKEN=
ALGOD_PORT=443

# Algorand indexer (MainNet) — pnpm -C proxy reconcile only. Lists confirmed
# USDC axfers into PAY_TO_ADDRESS for nightly claims-ledger reconciliation
# (SPEC-v3.md 5.2). Not read by the running proxy.
INDEXER_URL=https://mainnet-idx.algonode.cloud

# PaymentRouter app id, and the rekeyed payTo account that every paid route
# pays into. PAY_TO_ADDRESS is the leaderboard key — fixed for the whole
# competition. Never change it once payments land (CLAUDE.md invariant 1).
PAYMENT_ROUTER_APP_ID=
PAY_TO_ADDRESS=

# payTo's own mnemonic. Cold and offline; used for exactly two actions, in
# order: the USDC opt-in (scripts/optin-usdc.mjs) and the rekey to
# PaymentRouter (scripts/rekey-payto.mjs, R2). Never on the server. Set it
# locally only for the one rekey run, then clear it (SPEC §10.2: after the
# rekey the key has no signing power, so there is nothing left to protect
# by keeping it, but it should still never sit in a committed file).
PAY_TO_MNEMONIC=

# Attestation signing key (DSSE / ed25519). Unfunded, never used on-chain,
# separate from payTo/admin/pool keys. Hot on the server by necessity. Either
# a 25-word Algorand mnemonic or a hex-encoded 32-byte seed.
ATTEST_SIGNING_KEY=

# REQUIRED, every network — used as `predicate.issuer` and as the base of
# the predicate-type URLs on every signed statement (SPEC.md 12). The team
# does not own a placeholder domain, so the server refuses to boot without
# this set. Format: a bare https origin, no trailing slash, no path, no
# query, no fragment — e.g. https://spm.example.org (TestNet rehearsal:
# any bare https origin works; it never needs to resolve).
SPM_ISSUER_URL=

# REQUIRED, every network — `validFrom` published on the attestation signing
# key's entry at GET /.well-known/spm-keys.json. The server refuses to boot
# without this set. Format: an ISO-8601 UTC timestamp, e.g.
# 2026-01-01T00:00:00Z. Set to the real provisioning date.
SPM_KEY_VALID_FROM=

# Auditors allowed to anchor a review (scripts/record-review.mjs checks the
# anchor's sender against this list). Format: "github:<login>=<address>",
# comma-separated, e.g. "github:alice=ABCD...,github:bob=WXYZ...". Deploy
# (R2) also maps each of these into PaymentRouter's identity map, and
# refuses to map any address here that is not opted into USDC (SPEC §13.3).
AUDITORS=

# The address that claims PaymentRouter's ops pool (identity "ops",
# contract.algo.ts's OPS_IDENTITY). Deploy (R2) maps it the same way it maps
# each AUDITORS entry, and refuses if it is not opted into USDC (SPEC §13.3).
OPS_ADDRESS=

# Off-host directory the nightly job backs the SQLite database up to
# (VACUUM INTO a dated copy, moved here) before it credits a batch
# (SPEC.md §13.2 step 2). Set only for a bare, non-Docker `pnpm -C proxy
# nightly` run on the host itself. The containerized nightly job (systemd,
# deploy/systemd/spm-nightly.service) ignores this value: compose.yaml
# sets BACKUP_DIR to the fixed container path /backup and bind-mounts
# SPM_BACKUP_HOST_DIR there instead.
BACKUP_DIR=

# Host directory compose.yaml bind-mounts at /backup inside the proxy
# container (BACKUP_DIR above, container-side). The host's own backup ships
# it off the host daily. Not a path inside the repository clone. `docker compose up` and `docker
# compose run` both refuse to start until this is set. The container runs
# as the image's built-in "node" user (uid 1000, gid 1000 in the upstream
# node:*-bookworm-slim image — confirm with `docker compose run --rm proxy
# id` if the base image ever changes); the host directory must be writable
# by that uid, for example `sudo mkdir -p <path> && sudo chown 1000:1000
# <path>`.
SPM_BACKUP_HOST_DIR=

# Crediter key (ADR 0005). Server-side: the nightly job signs credit() calls
# with it. Never funded beyond transaction fees, separate from payTo/deployer.
CREDITER_MNEMONIC=

# Deployer/admin key. Workstation only — deploy and admin scripts read it to
# deploy PaymentRouter, set the crediter key, set the auditor map, and rekey
# payTo. Never set this on the server.
DEPLOYER_MNEMONIC=

# Donor wallet — client-side only (spm CLI / MCP server --donate flow, and
# the spm-attest GitHub Action's donor step). The server never reads this.
SPM_DONOR_MNEMONIC=

# scripts/e2e.mjs's 250-package on-chain PaymentRouter credit/claim
# rehearsal (R3a, SPEC §17: this rehearsal never runs on MainNet) is
# TestNet-only and hermetic: each run deploys its own fresh PaymentRouter
# for fresh, in-memory payTo/auditor/ops accounts, funded and mapped by the
# rehearsal itself. It needs no env vars beyond NETWORK=testnet and the
# three mnemonics above (DEPLOYER_MNEMONIC, CREDITER_MNEMONIC,
# SPM_DONOR_MNEMONIC) — no persistent app id, payTo, or claimant key.

# Proxy config
PORT=4873
SQLITE_PATH=./audit.db
SPM_PROXY_URL=http://localhost:4873

# TRUST_PROXY=1 | true (default: unset/false — do not trust X-Forwarded-For)
# Enable only when this proxy sits behind exactly one known reverse proxy
# (e.g. a load balancer or CDN edge) that itself appends the real client
# address as the last, rightmost entry of X-Forwarded-For before forwarding
# the request here. When enabled, the free-attest rate limiter reads that
# last entry. WARNING: enabling this with no such proxy in front — or with
# more than one hop — lets a caller spoof the header and bypass the
# free-path rate limit, the control against using SPM as an unpriced
# signing oracle.
TRUST_PROXY=
